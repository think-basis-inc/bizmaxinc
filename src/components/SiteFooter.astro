---
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-4 pt-10 pb-7 sm:px-6">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-start justify-between gap-8 text-[15px] leading-relaxed font-medium text-muted">
    <address class="flex flex-col gap-1.5 not-italic">
      <span class="font-bold text-ink">Business Maximization Inc</span>
      <span>6800 SW 65th Ave, Miami, FL 33143</span>
      <a href="mailto:bill@bizmaxinc.com" class="hover:text-green">bill@bizmaxinc.com</a>
    </address>
    <div class="flex flex-col items-start gap-3 font-semibold">
      <nav class="flex flex-wrap gap-6 text-ink" aria-label="Legal">
        <a href="/privacy" class="hover:text-green">Privacy Policy</a>
        <a href="/terms" class="hover:text-green">Terms of Service</a>
        <a href="https://discoverhiddenprofits.com" rel="noopener" class="hover:text-green">Discover Hidden Profits</a>
      </nav>
      <span class="text-sm font-medium text-quiet">© {year} Business Maximization Inc. All rights reserved.</span>
    </div>
  </div>
</footer>
