---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
    <h1 class="text-5xl font-heading font-bold tracking-tight text-navy sm:text-7xl">
      Bizmax Inc.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-gray sm:text-xl">
      Parent company of
      <a
        href="https://discoverhiddenprofits.com"
        class="text-gold underline decoration-1 underline-offset-4 transition-colors hover:text-gold-light"
      >
        Discover Hidden Profits
      </a>.
    </p>
  </main>
</Layout>
