---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Pill from '../components/Pill.astro';

export const prerender = true;
---

<Layout title="Page not found — Business Maximization Inc" description="That page does not exist." path="/404">
  <div class="p-3">
    <section class="flex min-h-[70vh] flex-col rounded-3xl bg-mint px-5 pb-14 sm:rounded-[32px] sm:px-6">
      <SiteHeader />
      <div class="flex flex-1 flex-col items-center justify-center gap-6 pt-14 text-center">
        <h1 class="text-[40px] leading-[1.02] font-extrabold tracking-[-0.04em] md:text-[64px]">
          <span class="text-quiet">Nothing hiding here.</span><br />That page doesn’t exist.
        </h1>
        <Pill href="/">Back to the home page</Pill>
      </div>
    </section>
    <SiteFooter />
  </div>
</Layout>
