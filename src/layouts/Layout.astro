---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path of the page, used for the canonical URL. */
  path?: string;
}

const SITE_NAME = 'Business Maximization Inc';
const SITE_URL = 'https://bizmaxinc.com';

const {
  title = `${SITE_NAME} — Your business is hiding profit.`,
  description = 'Your business is hiding profit. We find it and show you how to extract it. Business Maximization Inc builds diagnostic tools that find the gaps and hand owners a clear path forward.',
  path = '/',
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const metaDomainVerification = import.meta.env.PUBLIC_META_DOMAIN_VERIFICATION;
const ogImage = new URL('/og.png', SITE_URL).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  alternateName: 'Bizmax',
  url: SITE_URL,
  email: 'bill@bizmaxinc.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6800 SW 65th Ave',
    addressLocality: 'Miami',
    addressRegion: 'FL',
    postalCode: '33143',
    addressCountry: 'US',
  },
  brand: {
    '@type': 'Brand',
    name: 'Discover Hidden Profits',
    url: 'https://discoverhiddenprofits.com',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#d2e1d6" />
    {metaDomainVerification && <meta name="facebook-domain-verification" content={metaDomainVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body class="bg-white font-sans text-ink">
    <slot />
  </body>
</html>
