{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bizmaxinc",
  "account_id": "952979303e99711dbcc328d30a51a533",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "bizmaxinc.com", "custom_domain": true },
    { "pattern": "www.bizmaxinc.com", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_SITE_NAME": "Bizmax Inc.",
    "PUBLIC_SITE_URL": "https://bizmaxinc.com"
  }
}
